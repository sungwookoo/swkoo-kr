{
  "name": "swkoo-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "swkoo.kr portfolio frontend built with Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
